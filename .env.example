# ==============================================================================
# POLYMARKET 跟单机器人 - 环境变量示例（.env.example）
# ==============================================================================
# 使用方式：复制本文件为项目根目录下的 .env，按说明填写；键名须与 src/config/env.ts 一致。
# 勿将 .env 提交到 git（已 .gitignore）。Dry Run（npm run dryrun）与实盘（npm run dev / start）
# 共用大部分变量；行为对齐说明见 docs/DRY_RUN_LIVE_PARITY.md。
# ==============================================================================

# ------------------------------------------------------------------------------
# 要跟单的交易员（必填其一或两列都填；支持逗号分隔或 JSON 数组）
# ------------------------------------------------------------------------------
# USER_ADDRESSES_FOLLOW：跟方向（与交易员同 outcome）
# USER_ADDRESSES_REVERSE：反买（对侧 outcome / oppositeAsset）
# 同一地址不能同时出现在两列；至少配置一个地址（可只填一列）。
USER_ADDRESSES_FOLLOW = ''
USER_ADDRESSES_REVERSE = ''

# ------------------------------------------------------------------------------
# 钱包配置
# ------------------------------------------------------------------------------
# 你的 Polygon 钱包地址（必须与 PRIVATE_KEY 对应）
PROXY_WALLET = ''

# 钱包私钥（不带 0x 前缀）
# ⚠️  切勿泄露此密钥或将 .env 文件提交到 git！
PRIVATE_KEY = ''

# ------------------------------------------------------------------------------
# POLYMARKET API 端点
# ------------------------------------------------------------------------------
CLOB_HTTP_URL = 'https://clob.polymarket.com/'
CLOB_WS_URL = 'wss://ws-subscriptions-clob.polymarket.com/ws'

# ------------------------------------------------------------------------------
# Polymarket Builder API（可选）
# ------------------------------------------------------------------------------
# 在 https://polymarket.com/settings?tab=builder 创建；三组值需同时填写才会生效。
# 用途：
#   • CLOB 下单自动附加 POLY_BUILDER_* 头 → 订单归因、Builder 排行榜 / 激励
#   • 与 Relayer 使用同一套 Builder 认证（见官方文档）
#     https://docs.polymarket.com/api-reference/relayer/submit-a-transaction
# ⚠️  等同于密钥：勿提交 git、勿发聊天/前端；泄露请立即在后台撤销并重新生成。
# POLY_BUILDER_API_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
#
# 说明：本仓库当前赎回仍走 Polygon 链上 redeemPositions（自付 gas）。Relayer POST /submit
# 可做 gasless 交易，但需自行构造 Safe/Proxy 交易体与用户签名，未在此机器人中封装。

# ------------------------------------------------------------------------------
# 机器人设置
# ------------------------------------------------------------------------------
# 检查新交易的频率（秒）
FETCH_INTERVAL = 1

# 忽略多久之前的交易（小时）
TOO_OLD_TIMESTAMP = 1

# 订单失败最大重试次数
RETRY_LIMIT = 3

# 网络请求超时时间（毫秒，默认: 10000 = 10 秒）
# 如果频繁遇到超时错误，可适当调大
REQUEST_TIMEOUT_MS = 10000

# 网络错误最大重试次数（默认: 3）
# 用于处理 Polymarket API 临时连接问题
NETWORK_RETRY_LIMIT = 3

# ------------------------------------------------------------------------------
# 临时故障指数退避（Mongo / CLOB / 网络抖动：不退出进程，自动重试）
# 公式: delay = min(BASE * 2^min(连续失败次数-1, MAX_EXPONENT), MAX_MS)
# 用于 tradeMonitor、tradeExecutor、dryRun、主进程整体重连等
# ------------------------------------------------------------------------------
TRANSIENT_RETRY_BASE_MS = 2000
TRANSIENT_RETRY_MAX_MS = 120000
TRANSIENT_BACKOFF_MAX_EXPONENT = 16
# CLOB 创建 API 密钥 / 初始化客户端的最大尝试次数
CLOB_INIT_MAX_ATTEMPTS = 12
# 停止监控/执行器后等待多久再关 Mongo 并重连（毫秒，0=不等待）
TRANSIENT_RESTART_SETTLE_MS = 2000

# 周期性重新读取项目根目录 .env 并更新内存配置（毫秒，0=关闭；>0 时须 ≥5000）
# 数据库连接串与 RPC 端点仍以进程启动时为准，改 MONGO_URI / RPC_URL 请重启进程
ENV_FILE_RELOAD_INTERVAL_MS = 0

# 跟单回溯（Mongo：copy_tracking_sessions / copy_tracking_entries；启动 dev/dryrun 时自动开会话）
# false = 关闭写入（仍可用 npm run copy-tracking-export 导历史）
COPY_TRACKING_ENABLED = true
# 导出 Excel 目录（npm run copy-tracking-export）
COPY_TRACKING_REPORT_DIR = reports

# HTTP 请求代理（可选）
# true  = 对外 HTTP/HTTPS 请求走代理
# false = 直连
HTTP_PROXY_ENABLED = false
# 代理主机（本机代理通常 127.0.0.1）
HTTP_PROXY_HOST = '127.0.0.1'
# 代理端口（默认 7890）
HTTP_PROXY_PORT = 7890
# 是否让 RPC 绕过代理（默认 true）
# true  = RPC 直连（会把 RPC 域名加入 NO_PROXY）
# false = RPC 也走 HTTP 代理（当你本地网络直连 RPC 超时、必须经代理时使用）
HTTP_PROXY_BYPASS_RPC = true

# ------------------------------------------------------------------------------
# 邮件通知（QQ 邮箱 SMTP）
# ------------------------------------------------------------------------------
# 下单买入/卖出成功后发送邮件
EMAIL_NOTIFY_ENABLED = false
# QQ SMTP 配置：建议保持默认
EMAIL_SMTP_HOST = 'smtp.qq.com'
EMAIL_SMTP_PORT = 465
EMAIL_SMTP_SECURE = true
# 发件邮箱（QQ 邮箱地址）
EMAIL_SMTP_USER = ''
# QQ 邮箱 SMTP 授权码（不是登录密码）
EMAIL_SMTP_PASS = ''
# 发件人显示（可选，留空则使用 EMAIL_SMTP_USER）
EMAIL_FROM = ''
# 收件人（支持多个，逗号分隔）
EMAIL_NOTIFY_TO = ''
#
# HTTP 邮件兜底（可选，仅 Resend）：
# 当 SMTP 握手/投递失败时，可自动走 HTTPS API，适合代理/公司网络环境。
EMAIL_HTTP_FALLBACK_ENABLED = false
# 预留字段：当前仅支持 RESEND（AUTO 与 RESEND 等价）
EMAIL_HTTP_PROVIDER = 'AUTO'
# HTTP 通道发件地址（建议为 Resend 已验证域名邮箱，留空则回退 EMAIL_FROM/EMAIL_SMTP_USER）
EMAIL_HTTP_FROM = ''
# Resend API key（https://resend.com）
RESEND_API_KEY = ''

# ==============================================================================
# 跟单策略配置（新系统！）
# ==============================================================================
# 正买 / 反买由上方 USER_ADDRESSES_FOLLOW / USER_ADDRESSES_REVERSE 列决定，勿再使用旧版 COPY_MODE。
# 选择跟单策略: PERCENTAGE、FIXED 或 ADAPTIVE
# - PERCENTAGE: 按交易员订单固定比例跟单（推荐新手使用）
# - FIXED: 每次交易固定金额跟单（支出可预测）
# - ADAPTIVE: 根据交易大小动态调整比例（高级用法）
COPY_STRATEGY = 'PERCENTAGE'

# 主参数 - 含义取决于策略:
# - PERCENTAGE: 交易员订单的百分比（例如 10.0 = 10%）
# - FIXED: 每次交易的固定金额（例如 50.0 = $50）
# - ADAPTIVE: 自适应缩放的基础百分比（例如 10.0 = 10%）
COPY_SIZE = 10.0

# ------------------------------------------------------------------------------
# 安全限制（保护你的账户！）
# ------------------------------------------------------------------------------
# 单笔订单最大金额（USD，默认: 100.0）
# 即使交易员下了大额订单，也能防止过度交易
MAX_ORDER_SIZE_USD = 100.0

# 单笔订单最小金额（USD，默认: 1.0）
# 低于此值的订单将被跳过（Polymarket 最低要求）
MIN_ORDER_SIZE_USD = 1.0

# 可选：每个市场最大持仓总金额（USD）
# 防止在单个市场上积累过大仓位
# MAX_POSITION_SIZE_USD = 500.0

# 可选：每天最大交易总量（USD）
# 防止单日过度交易
# MAX_DAILY_VOLUME_USD = 1000.0

# ------------------------------------------------------------------------------
# 自适应策略参数（仅在 COPY_STRATEGY = 'ADAPTIVE' 时生效）
# ------------------------------------------------------------------------------
# 大额订单的最低百分比（默认: 5.0）
ADAPTIVE_MIN_PERCENT = 5.0

# 小额订单的最高百分比（默认: 20.0）
ADAPTIVE_MAX_PERCENT = 20.0

# 触发自适应的阈值（USD，默认: 500.0）
# 高于此金额的订单使用较低百分比，低于此金额的订单使用较高百分比
ADAPTIVE_THRESHOLD_USD = 500.0

# ==============================================================================
# 分层倍数（新功能！）
# ==============================================================================
# 根据交易员的仓位大小应用不同的倍数
# 解决的问题：复制不同规模交易员的仓位时资金分配不均：
# - 小额交易使用较高倍数（不放过机会）
# - 大额交易使用较低倍数（防止资金过度集中）
#
# 格式: "最小-最大:倍数,最小-最大:倍数,最小+:倍数"
# - 使用 "最小-最大" 表示有上下界的范围
# - 使用 "最小+" 表示无上限（必须放在最后）
# - 范围基于交易员的订单金额（USD）
#
# 示例：$2k 账户复制一个 $500k-$1M 的交易员：
# TIERED_MULTIPLIERS = 1-10:2.0,10-100:1.0,100-500:0.2,500-1000:0.1,1000-5000:0.02,5000-10000:0.01,10000-50000:0.002,50000-100000:0.001,100000-500000:0.0005,500000+:0.0002
#
# 效果说明：
# - $5 交易员订单 × 2.0x = $10 跟单（抓住小额交易）
# - $50 交易员订单 × 1.0x = $50 跟单
# - $500 交易员订单 × 0.1x = $50 跟单
# - $10,000 交易员订单 × 0.002x = $20 跟单
# - $250,000 交易员订单 × 0.0002x = $50 跟单（控制大额交易）
#
# 更简单的示例（$1k 账户）：
# TIERED_MULTIPLIERS = 1-100:2.0,100-1000:0.5,1000-10000:0.1,10000+:0.01
#
# 不设置则使用单一 TRADE_MULTIPLIER 或无倍数（1.0x）

# ==============================================================================
# 旧版配置（向后兼容）
# ==============================================================================
# 这些配置是为了兼容旧的 .env 文件而保留的
# 如果你没有设置 COPY_STRATEGY，机器人将使用以下配置：
# - COPY_PERCENTAGE: 交易员订单大小的百分比（默认: 10.0）
# - TRADE_MULTIPLIER: 应用到跟单比例的单一倍数（默认: 1.0）
# ⚠️  已废弃：请迁移到上方的 COPY_STRATEGY 系统！
# ⚠️  注意：如果设置了 TIERED_MULTIPLIERS，将覆盖 TRADE_MULTIPLIER
# COPY_PERCENTAGE = 10.0
# TRADE_MULTIPLIER = 1.0

# ------------------------------------------------------------------------------
# 交易聚合设置（新功能！）
# ------------------------------------------------------------------------------
# 启用小额交易聚合（默认: false）
# - true = 将同一交易员的多个小额交易合并为一笔较大的交易
# - false = 逐个执行每笔交易（原始行为）
# 💡 当交易员做了许多小额交易，每笔都低于 Polymarket 的 $1 最低限制，
#    但加起来值得跟单时，此功能非常有用！
TRADE_AGGREGATION_ENABLED = false

# 执行前等待更多交易的窗口时间（秒）
# 默认: 300（5 分钟）
# - 60 = 1 分钟
# - 300 = 5 分钟（推荐）
# - 600 = 10 分钟
# ⏱️  窗口时间越长，可合并的交易越多，但执行延迟也越大
TRADE_AGGREGATION_WINDOW_SECONDS = 300

# 预览/Dry-Run 模式（默认: false）
# - true = 监控交易但不执行（安全的测试模式）
# - false = 正常执行交易（实盘交易）
# 🔍 使用预览模式可以在不冒资金风险的情况下测试机器人！
PREVIEW_MODE = false

# ==============================================================================
# 模拟跟单测试 (Dry Run) - 可选参数
# ==============================================================================
# 运行命令: npm run dryrun
#
# 行为和 npm run dev 完全一样，检测交易员新交易，按订单簿模拟成交，不花真钱
# 初始模拟余额 (USD，默认: 1000)
# DRY_INITIAL_BALANCE = 1000
#
# 是否加载真实持仓作为起点 (默认: true)
# true = 从你钱包当前的真实持仓开始模拟
# false = 从零开始
# DRY_START_FROM_REAL = true

# ------------------------------------------------------------------------------
# Dry Run 输出降噪：每轮最多处理多少笔待模拟交易
# 目的是避免启动时 MongoDB 已积累大量 bot:true 且 botExcutedTime=0 的记录导致刷屏
# ------------------------------------------------------------------------------
# DRY_MAX_TRADES_PER_RUN = 20

# ------------------------------------------------------------------------------
# 订单簿缓存：减少 getOrderBook 频繁请求 + 404 错误刷屏
# ------------------------------------------------------------------------------
ORDERBOOK_CACHE_TTL_MS = 30000          # 缓存订单簿的有效期（毫秒）
ORDERBOOK_CACHE_MAX_ENTRIES = 500       # 缓存最多保存多少个 tokenId
ORDERBOOK_MISSING_LOG_THROTTLE_MS = 60000 # tokenId 404 时日志限流间隔（毫秒）

# ------------------------------------------------------------------------------
# BUY 价格保护：避免下单价格偏离交易员 price 太远
# 如果 best ask price - ORDER_PRICE_SLIPPAGE_USD > trade.price 则跳过
# ------------------------------------------------------------------------------
ORDER_PRICE_SLIPPAGE_USD = 1

# ------------------------------------------------------------------------------
# curPrice 缓存（Polymarket positions 接口里的 curPrice，用于估值与 dryrun 盈亏口径）
# ------------------------------------------------------------------------------
CUR_PRICE_CACHE_TTL_MS = 15000

# Data API positions?user= 多模块共享缓存（tradeMonitor / 对账 / curPrice 刷新等），减轻重复请求
# DATA_API_POSITIONS_CACHE_TTL_MS = 10000

# CLOB 公开 /midpoint、/last-trade-price 缓存（估值优先于整本 /book，减少 404）
# CLOB_LIGHT_PRICE_CACHE_TTL_MS = 15000

# ------------------------------------------------------------------------------
# 持仓估值：positions curPrice 与 CLOB 订单簿 mid 最大允许偏差（0~1 概率价）
# 超过则用 mid（dry run 与实盘 LIVE_PORTFOLIO 日志共用，见 src/utils/tokenMark.ts）
# ------------------------------------------------------------------------------
# MARK_CUR_VS_BOOK_DIVERGENCE = 0.12

# ------------------------------------------------------------------------------
# Dry Run：每隔多久打印一次「模拟持仓明细」（0 = 关闭）
# ------------------------------------------------------------------------------
DRY_POSITIONS_SNAPSHOT_INTERVAL_MS = 30000

# ------------------------------------------------------------------------------
# 实盘：成交后按 curPrice 打印钱包持仓总估值的最小间隔（毫秒，0 = 关闭）
# ------------------------------------------------------------------------------
LIVE_PORTFOLIO_CURPRICE_LOG_INTERVAL_MS = 60000

# ------------------------------------------------------------------------------
# 两头买风控（同一市场 Up+Down 同时买入）
# GLOBAL: 只要该 condition 已持有另一侧，就跳过新 BUY（默认，最保守）
# TRADER_ONLY: 仅同一交易员导致的另一侧仓位才跳过
# OFF: 关闭该风控
# ------------------------------------------------------------------------------
COPY_DOUBLE_SIDE_GUARD_MODE = GLOBAL
# 内存锁有效期（毫秒，默认 600000 = 10 分钟）
# 作用：同一 condition 一旦在本进程买入某一侧，在 TTL 内阻止另一侧 BUY，
# 用于覆盖 positions API 延迟导致的双向新增仓位。
COPY_DOUBLE_SIDE_GUARD_LOCK_TTL_MS = 600000
# 亏损熔断（按交易员地址统计）：
# true  = 启用，触发后本次进程停止跟单该交易员并发邮件提醒
# false = 关闭
COPY_STOP_ON_LOSS_ENABLED = true
# 连续亏损达到 N 次后停止（默认 10）
COPY_STOP_LOSS_STREAK = 10
# 累计亏损达到 N 美金后停止（默认 50）
COPY_STOP_LOSS_USD = 50
# ------------------------------------------------------------------------------
# 跟单前：临近结束（endDate）跳过跟单（仅 BUY）
# ------------------------------------------------------------------------------
# 从 Polymarket positions 取该 condition 的 endDate；若距离当前不足 N 分钟则跳过本条 BUY，
# 减少「刚买进窗口就结束 / 订单簿 404 / 被对账模块按结算价平掉」等情况。
# 与「反买 / 正买」无关，仅控制是否开新仓。
#   0 或负数 = 关闭此跳过逻辑
# ------------------------------------------------------------------------------
COPY_SKIP_FOLLOW_IF_ENDS_WITHIN_MINUTES = 5

# ------------------------------------------------------------------------------
# 仓位对账（实盘 npm start / npm run dev 与 模拟 npm run dryrun 共用）
# ------------------------------------------------------------------------------
# 与下方「自动止盈止损」不同：对账依据「镜像腿已平 / 市场已结算 redeemable / curPrice≈0 或 1」等，
# 不要求达到 TP/SL 收益率；日志里多为「🧹 仓位对账平仓」。
# 仅处理 Mongo 里有过跟单 TRADE 且已被 bot 认领的 condition，避免卖你手动开的仓。
# Dry Run：按订单簿模拟卖；不广播链上交易；AUTO_REDEEM=true 时仅日志提示实盘会赎回。
# ------------------------------------------------------------------------------
# 对账周期（毫秒）。0 = 关闭（与代码默认一致）。示例：180000 = 每 3 分钟
POSITION_RECONCILE_INTERVAL_MS = 60000
#
# 每轮最多处理多少条持仓（防止一次触发过多下单）
POSITION_RECONCILE_MAX_PER_RUN = 5
#
# 同一 conditionId+asset 平仓后的冷却时间（毫秒）
POSITION_RECONCILE_COOLDOWN_MS = 120000
#
# 跟单钱包在「镜像腿」上已无仓时，自动卖出你方对应持仓（默认 true）
POSITION_RECONCILE_ON_TRADER_EXIT = true
#
# 市场已结算：curPrice≈0/1 或 API redeemable 时自动卖（默认 true）
POSITION_RECONCILE_ON_RESOLVED = true
#
# 链上赎回（仅实盘生效，需 Polygon gas；与 npm run redeem-resolved 同类）
POSITION_RECONCILE_AUTO_REDEEM = true

# ------------------------------------------------------------------------------
# 自动止盈 / 止损（AUTO EXIT，机器人跟单 BUY 成功后对该 condition+asset 持仓监控）
# ------------------------------------------------------------------------------
# 触发口径：以 Polymarket Data API「positions」里的 ROI 为主（percentPnl 或 initialValue/currentValue）。
# 日志前缀多为「[AUTO EXIT]」。止盈卖出前会结合订单簿校验可成交额（避免假 TP）；极低价仓位 API
# 可能失真，代码会用本地记录的投入÷数量作为参考成本参与校验。
#
# 条件（启用时 AUTO_PROFIT_EXIT_ENABLED=true）：
#   - 止盈：percentPnl >= AUTO_PROFIT_EXIT_TAKE_PROFIT_PCT
#   - 止损：percentPnl <= -AUTO_PROFIT_EXIT_STOP_LOSS_PCT
#
# 关闭单侧（当前版本语义）：
#   - AUTO_PROFIT_EXIT_TAKE_PROFIT_PCT <= 0  → 关闭自动止盈（不再因 ROI 触发卖出）
#   - AUTO_PROFIT_EXIT_STOP_LOSS_PCT <= 0   → 关闭自动止损（升级前 SL=0 曾等价于「一浮亏就卖」，请勿混用旧构建）
#
# percentPnl 单位：百分数，如 80 表示 +80%。
# ------------------------------------------------------------------------------
AUTO_PROFIT_EXIT_ENABLED = false
# 目标收益率达到则尝试止盈（配合下方 MIN_EXEC 与订单簿深度）
AUTO_PROFIT_EXIT_TAKE_PROFIT_PCT = 80
# 仅止盈单：按买盘深度估算「若全部 FOK 卖出」的 PnL% 须 >= 本值才执行卖出；默认 0 = 至少不亏才卖
AUTO_PROFIT_EXIT_TAKE_PROFIT_MIN_EXEC_PNL_PCT = 0
# 亏损达到本值（正数）则止损；0 或负数 = 不启用止损
AUTO_PROFIT_EXIT_STOP_LOSS_PCT = 25
# 轮询检查间隔（毫秒）；越小越及时，但 positions 请求更频繁
AUTO_PROFIT_EXIT_CHECK_INTERVAL_MS = 500
# 同一仓位平仓失败后再次尝试的最小间隔（毫秒）
AUTO_PROFIT_EXIT_RETRY_COOLDOWN_MS = 30000
# 平仓后剩余 token 数低于该值视为已清仓并清理 tracked BUY（单位：股）
AUTO_PROFIT_EXIT_CLEAR_WHEN_REMAINING_LT_TOKENS = 1.0

# ------------------------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------------------------
# MongoDB 连接字符串
# ⚠️  保密！切勿泄露或提交到 git！
MONGO_URI = 'mongodb+srv://myusername676:mypassword676@cluster0.qzpwa2p.mongodb.net/?appName=Cluster0'

# ------------------------------------------------------------------------------
# 区块链配置（Polygon 主网）
