# ==============================================================================
# 马丁格尔策略 · 专用环境变量（示例文件）
# ==============================================================================
# 【这是什么】
#   针对 Polymarket 上「BTC/ETH/SOL 在 5 分钟 / 15 分钟内涨或跌」这类短时二元市场：
#   每开一个窗口可以随机选一边下注；若输了，下一窗口按倍数加倍下注（马丁格尔），
#   直到赢一局把前面亏的「理论上」赢回来，或连输达到上限后整段序列清零重来。
#
# 【和跟单 .env 的关系】
#   跟单机器人用的钱包、CLOB、Mongo 等仍在根目录 `.env` 里配置。
#   本文件只放「马丁格尔」相关开关和参数，避免和跟单配置挤在一起。
#
# 【怎么生效】
#   运行 npm run martingale-dryrun / martingale-backtest / martingale-live 时：
#   入口 `martingalePreamble` 会先读 `.env`，再读 `.env.martingale`（后者覆盖同名键），并抑制跟单启动摘要。
#
# 【你怎么用】
#   复制本文件为项目根目录下的 `.env.martingale`（该文件已在 .gitignore，勿提交），
#   按下面中文说明改 true/false 和数字即可。
# ==============================================================================

# ------------------------------------------------------------------------------
# 总开关：模拟盘轮询（不写区块链、不扣真钱）
# ------------------------------------------------------------------------------
# true  = 允许执行 `npm run martingale-dryrun`，进程会一直轮询 Gamma，发现可下注的开放市场就
#         在内存里记一笔「模拟挂单」，等该窗口收盘后按结果更新马丁步数，并往 Excel 里写一行。
# false = 执行 dryrun 时脚本会直接退出（防止误开模拟进程）。
MARTINGALE_ENABLED = false

# ------------------------------------------------------------------------------
# 总开关：实盘（真下单）
# ------------------------------------------------------------------------------
# true  = 允许执行 `npm run martingale-live`，会用 CLOB 下真实买单。
# false = 不跑实盘脚本（即使误敲命令也不会下单）。
# 与根 `.env` 的关系见下：可选「完全隔离」或「仅覆盖部分键」。
MARTINGALE_LIVE_ENABLED = false

# ------------------------------------------------------------------------------
# 实盘：与跟单根 `.env` 完全隔离（推荐专机只跑马丁时使用）
# ------------------------------------------------------------------------------
# false = 沿用根 `.env` 的 RPC/CLOB/Mongo/USDC/私钥等；仍可在下方填写个别 MARTINGALE_LIVE_* 做**增量覆盖**（非空则覆盖本进程 ENV）。
# true  = **仅**使用下方 MARTINGALE_LIVE_*（根 `.env` 中同名项不再参与马丁实盘）；RPC/CLOB/私钥/代理/USDC 必填；**Mongo 可选**（不填则不连库、健康检查跳过数据库项）。WS 可留空则用默认 wss。
# 注意：仅 `npm run martingale-live`（入口先设 MARTINGALE_SUPPRESS_COPY_LOG）会启用隔离校验；`npm start` 跟单不受此开关影响。
MARTINGALE_LIVE_CONFIG_ISOLATED = false

# 隔离=true 时必填；隔离=false 时可选（非空则覆盖本进程）
MARTINGALE_LIVE_RPC_URL =
MARTINGALE_LIVE_CLOB_HTTP_URL =
# 留空且隔离=true 时使用默认 wss://ws-subscriptions-clob.polymarket.com/ws
MARTINGALE_LIVE_CLOB_WS_URL =
# 可选；留空则马丁实盘不连接 Mongo（跟单库表与此无关）
MARTINGALE_LIVE_MONGO_URI =
# Polygon USDC 合约，通常 0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
MARTINGALE_LIVE_USDC_CONTRACT_ADDRESS =
MARTINGALE_LIVE_PRIVATE_KEY =
MARTINGALE_LIVE_PROXY_WALLET =

# 可选：马丁实盘专用 HTTP 代理（非空且 MARTINGALE_LIVE_HTTP_PROXY_ENABLED=true 时覆盖本进程代理设置）
MARTINGALE_LIVE_HTTP_PROXY_ENABLED = false
MARTINGALE_LIVE_HTTP_PROXY_HOST =
MARTINGALE_LIVE_HTTP_PROXY_PORT =
# true/false，与根 .env 的 HTTP_PROXY_BYPASS_RPC 同义
MARTINGALE_LIVE_HTTP_PROXY_BYPASS_RPC =

# ------------------------------------------------------------------------------
# 定期链上赎回（仅 martingale-live，消耗 Polygon gas）
# ------------------------------------------------------------------------------
# 每隔这么多分钟扫描一次 Data API `positions?user=PROXY_WALLET`，对「redeemable=true 且 curPrice 贴近 0/1」的 condition
# 调用链上 redeemPositions（与 `npm run redeem-resolved` 一致），条件之间间隔 2s。
# 0 = 关闭。建议 15～60，避免过于频繁打 RPC/Gas。
# 【重要】链上 gas 由「本进程生效的 PRIVATE_KEY」对应地址支付（若配置了 MARTINGALE_LIVE_PRIVATE_KEY 则用该地址）；MATIC=0 会赎回失败（与 PROXY_WALLET 上 USDC 无关）。
MARTINGALE_REDEEM_INTERVAL_MINUTES = 0

# ------------------------------------------------------------------------------
# 邮件通知（SMTP 与跟单共用根目录 `.env`）
# ------------------------------------------------------------------------------
# 须根 `.env`：`EMAIL_NOTIFY_ENABLED=true`，并配置 `EMAIL_SMTP_*`、`EMAIL_NOTIFY_TO`（或 `EMAIL_HTTP_FALLBACK_ENABLED`+Resend）。
# true = 下单成功后发信（live=真成交；dryrun=模拟挂单）；false = 不发。
MARTINGALE_EMAIL_ON_ORDER = false
# true = 窗口结算（写入 Excel）后发信，正文含本局盈亏、会话累计已实现、下一档策略；false = 不发。
MARTINGALE_EMAIL_ON_SETTLE = false
# true = 趋势跟单模式下，输出「待收盘」日志时若挂单押边与 CLOB/Gamma 偏高侧不一致则发告警邮件（每 slug+窗起点去重一次）；false = 不发。
MARTINGALE_EMAIL_ON_TREND_MISMATCH = false

# ------------------------------------------------------------------------------
# 做哪些币、哪些周期
# ------------------------------------------------------------------------------
# 填大写英文，逗号分隔。可选：BTC、ETH、SOL（对应链上/页面上常见的比特币、以太坊、Solana 短时盘）。
# 只想跑以太坊就写成：MARTINGALE_ASSETS = ETH
MARTINGALE_ASSETS = BTC,ETH,SOL

# 周期：只能填 **一个** —— 5m **或** 15m（禁止写 5m,15m；同一进程不支持同时跑两种粒度）。
# 与 Polymarket slug 中 -5m- / -15m- 一致；未填时默认 5m。
# 加载顺序：先读根目录 .env，再读 .env.martingale（后者覆盖同名键）。若本文件未写该键，可能仍沿用 .env 里旧值。
# 重要：`npm run martingale-live` 会加载 `src/config/env.ts`；已改为与 preamble 一致先合并 .env 再 .env.martingale（后者覆盖）。
# 若根 `.env` 曾写 MARTINGALE_INTERVALS=15m 而本文件未覆盖，旧行为可能让实盘仍用 15m；请在本文件显式写 5m 或删根 .env 里该项。
# 发现逻辑会用 Gamma endDate 与窗起点核对时长，剔除 slug 与真实窗长不符的错配盘。
MARTINGALE_INTERVALS = 5m

# ------------------------------------------------------------------------------
# 下注金额与马丁规则
# ------------------------------------------------------------------------------
# 每一小段「连输后重来」的序列里，第一次下注用的美元名义金额（只是目标值；实盘会受盘口深度限制）。
# 输了一次以后，下一笔会变成 2 倍、再输再 2 倍……直到赢或达到下面「最多连下几笔」上限。
# 模拟盘可单独用 MARTINGALE_DRYRUN_BASE_STAKE_USD 覆盖，不必与实盘心理价位绑死。
MARTINGALE_BASE_STAKE_USD = 1

# 这一条马丁链最多连续下几笔（默认 4 表示：1x、2x、4x、8x 四档本金倍数）。
# 若第 4 笔还输，程序会认为这一段马丁「失败」，把步数清零，下一窗口又从基础金额重新开始。
MARTINGALE_MAX_STEPS = 4

# Polymarket 买单一般要求单笔至少约 1 美元名义；若你算出来的倍数金额小于此值，会被抬到至少这么多。
MARTINGALE_MIN_ORDER_USD = 1

# ------------------------------------------------------------------------------
# 新开仓选边（dryrun / live 共用 martingaleRunner）
# ------------------------------------------------------------------------------
# random       = 每窗随机 Up/Down（默认）。
# trend_follow = 「趋势跟单」：每个理论窗内，用 CLOB/Gamma 两侧价监控；**第一次**从低于阈值抬升到 ≥ MARTINGALE_TREND_FOLLOW_MIN_LEADING_PRICE 的那一侧锁死为本窗押注边（另一侧后涨到阈值也不改，避免来回震荡换边）。
# 与待收盘日志里的「趋势结果」数据源一致。
MARTINGALE_ENTRY_SIDE_MODE = random
# trend_follow 下：穿越阈值用的隐含价下限（0.51～0.99，默认 0.7）。
MARTINGALE_TREND_FOLLOW_MIN_LEADING_PRICE = 0.7
# 当前实现未参与过滤（保留键）。曾计划用于价差过滤。
MARTINGALE_TREND_FOLLOW_MIN_SPREAD = 0
#
# trend_follow 下连输时的下一笔名义（与随机模式 2^step×基础 不同）：
#   MARTINGALE_TREND_FOLLOW_MIN_LEADING_PRICE 仅用于「何时满足趋势信号 / 首次穿越」，不是公式里的固定 p。
#   每笔输后 T += stakeUsd/entryPrice，其中 entryPrice 为**该笔结算所用真实入场价**（实盘=成交均价 buy.execPrice，非阈值 0.7）。
#   下一笔算 S≈T×p/(1−p) 时，p 优先取**当前要买的 token 的 CLOB 轻量价**（拿不到再回退 Gamma 侧价），以贴近下单瞬间盘口；成交后仍以真实成交价计入下一轮 T。
#
# 【数值示例】首笔基础 1U、且每档参考隐含价均取 p=0.7（实际每档 p 会随盘口变，程序按当档 entry 计算）：
#   第1档 下单约 1.00U @0.7 → 若亏，T = 1/0.7 ≈ 1.4286
#   第2档 下单约 3.33U @0.7（= 1.4286×0.7/0.3）→ 若再亏，T ≈ 1.4286 + 3.33/0.7 ≈ 6.19
#   第3档 下单约 14.44U @0.7（= 6.19×0.7/0.3）→ 若再亏，T ≈ 6.19 + 14.44/0.7 ≈ 26.83
#   第4档 下单约 62.59U @0.7 → 若再亏，T ≈ 26.83 + 62.59/0.7 ≈ 116.24
#   第5档 下单约 271.23U @0.7（= 116.24×0.7/0.3）→ 再亏则视 MARTINGALE_MAX_STEPS 是否触顶重置
#   以上为理想演算，实盘有最小名义、成交滑点与手续费，会与表内数字略有出入。

# ------------------------------------------------------------------------------
# 仅模拟盘（npm run martingale-dryrun）专用覆盖项（留空则与下面「共用」一致）
# ------------------------------------------------------------------------------
# 模拟时的「第一笔基础金额」。不填则使用下面的 MARTINGALE_BASE_STAKE_USD。
# 用途：实盘想 5U、模拟想 1U 时，只改这里即可，不必来回改共用值。
MARTINGALE_DRYRUN_BASE_STAKE_USD =

# 模拟轮询间隔（秒）。不填则使用 MARTINGALE_POLL_INTERVAL_SEC。
MARTINGALE_DRYRUN_POLL_INTERVAL_SEC =

# true = 每次执行 npm run martingale-dryrun 时先删除 MARTINGALE_STATE_FILE，并清空 runner 内存锚点；
#        各「资产+周期」均从首笔、基础金额重来（解决「以为刚启动但某币已是第 2 笔」——实为上次 state 残留）。
# false = 沿用磁盘 state（默认）。
MARTINGALE_DRYRUN_RESET_STATE_ON_START = false

# ------------------------------------------------------------------------------
# 新单风控：离收盘太近则不下注
# ------------------------------------------------------------------------------
# 若 Gamma 返回的 endDate 距离现在不足这么多秒，则本回合**不下新单**（已有挂单仍会等结算）。
# 避免贴在截止前几秒进场。设为 0 表示关闭此检查（不推荐）。
MARTINGALE_MIN_REMAINING_SEC_TO_ENTER = 120

# ------------------------------------------------------------------------------
# 逾期结算：Gamma 迟迟不标 closed 时解除卡死（dryrun / live 共用）——**最影响「多久才能挂下一单」**
# ------------------------------------------------------------------------------
# 以「本窗 windowStart + 周期秒数」为理论结束时刻，之后再等本宽限（秒）。
# 若此时 Gamma 仍 closed=false，但 outcomePrices 已可明确推断胜负，则**强制按推断结算**并释放挂单，
# Excel notes 会带 force_settle_gamma_lag；控制台标 ⚡逾期推断。
# 0 = 关闭（默认，只认官方 closed=true），Gamma 晚标 closed 时你会一直卡在待结算，下一窗开仓会晚。
# 5m 盘若设 300：理论收盘后还要再等满 300s 才尝试推断，**极易体感「拖了两三分钟」**；更常设 30～90（越快越依赖推断，风险自负）。
# 15m 盘可酌情加大。请自行承担推断与链上最终结果不一致的风险。
MARTINGALE_FORCE_SETTLE_GRACE_AFTER_WINDOW_SEC = 5

# ------------------------------------------------------------------------------
# 快速结算：理论窗结束后用 CLOB 两侧价推断胜负（优先于上一项 Gamma 价推断，更快挂下一窗）
# ------------------------------------------------------------------------------
# 理论窗结束（windowStart+周期）后再等本秒数，若 Gamma 仍 closed=false，则拉两侧 token 的 CLOB midpoint/last-trade 价，
# **价高对应的 outcome 视为胜出**（与待收盘日志里「趋势结果」同源思路）；与你押边对比算输赢后释放挂单。
# 0 = 关闭（默认）。追求体感可设 5～10；越小越早结算，但与官方 closed 不一致的风险越高。
# 若本项与 FORCE_SETTLE 均开启：先满足「理论结束+BOOK 延迟」尝试订单簿；若不成立再在「理论结束+FORCE 宽限」用 Gamma outcomePrices。
MARTINGALE_BOOK_SETTLE_AFTER_WINDOW_SEC = 0
# 两侧价之差的绝对值低于该值则不采用订单簿推断（避免 0.50/0.50 噪声）；0 = 不检查价差，直接按较高一侧胜。
MARTINGALE_BOOK_SETTLE_MIN_SPREAD = 0.03

# ------------------------------------------------------------------------------
# 启动后先等「下一窗」再下首单（dryrun / live 共用）
# ------------------------------------------------------------------------------
# true  = 本 Node 进程启动后，每个「资产+周期」在**尚未成功挂过首单**前额外约束：
#         · 用 slug 的 windowStart+周期 计算「理论剩余秒数」，若低于 MARTINGALE_MIN_REMAINING_SEC_TO_ENTER 则**绝不开仓**
#           （不依赖 Gamma endDate，避免 endDate 缺失时仍尾盘进场）。
#         · 若 wall clock 尚未到 picked 的 windowStart，则等待（下一窗理论未开始不进）。
#         · 若 discover 仍指向上一段 windowStart（早于当前理论窗起点），则跳过。
#         · 若 picked 对应当前理论窗，且本窗已运行超过 MARTINGALE_STARTUP_CURRENT_WINDOW_GRACE_SEC，则**不追尾盘**，
#           等 discover 指向下一段 windowStart 再开首单。
#         首单成交后该序列不再套用上述冷启动规则（与旧版「滚过锚点窗」语义一致）。
# false = 不做上述首单约束（仍受「理论剩余≥MIN_REMAINING」与 discover 临期过滤保护）。
MARTINGALE_STARTUP_WAIT_NEXT_WINDOW = false

# 与上一项配合：从「当前理论窗起点」起算，超过这么多秒则启动阶段不允许把首单挂在**当前这一格**窗上（0=关闭此条，仅依赖 MIN_REMAINING）。
# 默认 120 与常见 MIN_REMAINING 对齐；若你希望「刚进入新 5m 格的前 30 秒仍可首单」，可改为 30。
MARTINGALE_STARTUP_CURRENT_WINDOW_GRACE_SEC = 120

# ------------------------------------------------------------------------------
# 挂单等待结算时的控制台心跳（解决「下了单以后很久没日志」的疑惑）
# ------------------------------------------------------------------------------
# 挂单未收盘时，至少隔多少秒重复打一条「待收盘」摘要（默认 60，控制台更干净）。
# 设为 0 则每轮轮询都打（很吵，仅排错时用）。
MARTINGALE_WAITING_SETTLEMENT_LOG_SEC = 60

# 单行「⏳ 待收盘」心跳间隔（秒）：每条含数字倒计时 MM:SS、马丁第几笔/已倍投几次等；默认 10。
# 与上一项独立：详日志(MARTINGALE_LOG_VERBOSE=true)仍用上一项节流。0=每轮轮询都打。
MARTINGALE_PENDING_COUNTDOWN_LOG_SEC = 10

# Gamma 已过期/已过理论窗时，紧凑待收盘日志最小间隔（秒，默认 5，范围 2～120）。
# 与上一项取较大者；避免 POLL_AFTER_EXPIRED=2s 时每 2 秒重复整段「已过期」刷屏。
MARTINGALE_PENDING_EXPIRED_HEARTBEAT_MIN_SEC = 5

# true：多行详解（监控逻辑长文块）；false：单行摘要（默认，推荐日常）
MARTINGALE_LOG_VERBOSE = false

# ------------------------------------------------------------------------------
# 控制台盘口链接：终端超链接（OSC 8，类 HTML 可点击；非真实 HTML）
# ------------------------------------------------------------------------------
# 默认开启：在支持 OSC 8 的终端（VS Code 集成终端、Windows Terminal、iTerm2 等）里，
# 马丁日志中的 polymarket.com/event/{slug} 显示为可 Ctrl+点击 的链接（与站点 5m/15m 短时盘页一致）。
# false = 始终输出纯 URL 文本。CI 环境或非 TTY 会自动关闭。
MARTINGALE_TERMINAL_HYPERLINK = true

# false = 关闭马丁 dryrun/live/backtest 的 ANSI 颜色与额外图标（配合 NO_COLOR 也会关闭）
MARTINGALE_LOG_COLOR = true

# ------------------------------------------------------------------------------
# 轮询多快查一次（秒，与 live 共用默认值）——**第二影响时效**（在仍有 openBet、等 closed/推断时）
# ------------------------------------------------------------------------------
# dryrun 和 live 默认共用：每隔这么多秒扫一轮。模拟盘可用上一项单独覆盖。
# 太小会请求更频繁；太大可能错过很短的窗口。15～30 秒是常见折中。
MARTINGALE_POLL_INTERVAL_SEC = 15

# 临收盘/待结算：当挂单距 Gamma endDate 不足该秒数，或已过期，或本轮刚完成结算，或 slug 拉盘失败时，
# 下一轮休眠取 min(MARTINGALE_POLL_INTERVAL_SEC, 下项)。设为 0 则仅「已过期(rem<0)」等仍加速，不按「距收盘剩余」加速。
MARTINGALE_NEAR_CLOSE_POLL_THRESHOLD_SEC = 120

# 与上项配合：加速时的休眠秒数（与常规轮询取较小者），默认 3；可调到 2～8。
# 另：本轮若发生过结算，脚本会**立刻再跑一整轮** scan（无休眠），再接下一窗 discover/开仓。
MARTINGALE_POLL_INTERVAL_NEAR_CLOSE_SEC = 3

# Gamma endDate 已过期(rem<0)或已过本窗理论结束时间时，休眠再与上两项取 min，默认 2（秒）。
# 紧凑待结算日志在该状态下也会每轮打印（不再受 MARTINGALE_PENDING_COUNTDOWN_LOG_SEC 拉长间隔），避免「像卡住」。
MARTINGALE_POLL_INTERVAL_AFTER_EXPIRED_SEC = 2

# ------------------------------------------------------------------------------
# Gamma HTTP（slug / markets 列表；独立于根目录 .env 的 REQUEST_TIMEOUT_MS / NETWORK_RETRY_LIMIT）
# ------------------------------------------------------------------------------
# 单次请求超时（毫秒）。代理慢或国际链路抖动时可加大，例如 35000。
MARTINGALE_HTTP_TIMEOUT_MS = 25000
# 单次 URL 内失败重试次数（指数退避 1s、2s、4s…），范围 1～10。
MARTINGALE_HTTP_RETRY_LIMIT = 5

# ------------------------------------------------------------------------------
# 本地状态文件（JSON）
# ------------------------------------------------------------------------------
# 记录每个「币+周期」当前马丁走到第几步、有没有尚未结算的挂单等。删了相当于忘掉所有进行中的马丁状态。
MARTINGALE_STATE_FILE = reports/martingale-state.json

# 可选：仅 `npm run martingale-live` 读写此路径；`martingale-dryrun` / 回测仍用上面的 MARTINGALE_STATE_FILE。
# 用于与模拟盘隔离「累计已实现」与马丁档位（避免 dryrun 盈亏显示在实盘启动日志里）。
# 留空 = 实盘与模拟共用 MARTINGALE_STATE_FILE。
# MARTINGALE_LIVE_STATE_FILE = reports/martingale-state-live.json

# ------------------------------------------------------------------------------
# Excel 报表路径
# ------------------------------------------------------------------------------
# 每次一个窗口结算出结果，会往这个 xlsx 里追加一行（含 conditionId、tokenId、成交价、模拟/实盘等列）。
# 想换一份新表可以改路径或删掉旧文件让程序重建表头。
MARTINGALE_EXCEL_PATH = reports/martingale-history.xlsx

# ------------------------------------------------------------------------------
# 随机种子（整数，可留空）
# ------------------------------------------------------------------------------
# 填固定数字：每次随机选「涨/跌」时可复现，方便对比两次回测。
# 留空：dryrun / live 每次启动用不同随机序列。
MARTINGALE_RANDOM_SEED =

# ------------------------------------------------------------------------------
# 模拟/回测时用的「假设买入价」
# ------------------------------------------------------------------------------
# 取值 0～1，表示概率价。当 Gamma 上取不到某一边的现价时，用这个数估算盈亏（不是链上真实成交价）。
# 实盘成交以订单簿为准，这个值主要影响模拟和回测。
MARTINGALE_ASSUMED_ENTRY_PRICE = 0.5

# ------------------------------------------------------------------------------
# 按「整点窗口」拼 slug 时，向前多试几个过去的窗口
# ------------------------------------------------------------------------------
# 有时接口上当前这一窗的 slug 会晚半拍出现，多试几个历史 unix 窗更容易命中。
MARTINGALE_SLUG_LOOKBACK_WINDOWS = 2

# ------------------------------------------------------------------------------
# 若按 slug 找不到开放市场：是否用「拉 Gamma 市场列表」兜底
# ------------------------------------------------------------------------------
# true（推荐）：分页拉活跃市场，在列表里找名字/slug 符合 btc/eth/sol 的 updown 5m/15m 盘。
# false：只用 slug 规则，不再扫列表（请求更少，但更容易找不到盘）。
MARTINGALE_GAMMA_FALLBACK_ENABLED = true

# 兜底时每页拉 100 条，最多翻多少页。越大越可能命中，但也越容易触发接口限流，一般 10～20 即可。
MARTINGALE_GAMMA_FALLBACK_MAX_PAGES = 15

# ------------------------------------------------------------------------------
# 仅回测脚本 martingale-backtest 使用
# ------------------------------------------------------------------------------
# 从今天往前一共模拟多少天的历史窗口（按 5m/15m 步长去扫 slug；没有数据的窗口会自动跳过）。
MARTINGALE_BACKTEST_DAYS = 7

# 每请求一次 Gamma 中间隔多少毫秒，减轻限流（网络慢时可略加大）。
MARTINGALE_BACKTEST_REQUEST_GAP_MS = 120
